# Server Configuration
PORT=5000

# Database Configuration (Production - Render PostgreSQL)
# Render automatically provides DATABASE_URL in your database settings
# Example: postgresql://username:password@dpg-xxxxxx-a.oregon-postgres.render.com/smart_beekeeping_db
DATABASE_URL=

# Database Configuration (Local Development fallback)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_beekeeping
DB_USER=postgres
DB_PASSWORD=

# CORS Configuration
# Set to your Vercel frontend URL in production (can be comma-separated for multiple origins)
# Example: https://smartbee.vercel.app,http://localhost:5173
FRONTEND_URL=

# Security
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Optional: AI Service (Ollama)
# Note: In production, Ollama is NOT required. If offline/unavailable, 
# SmartBee automatically uses its built-in rule-based advisory engine.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

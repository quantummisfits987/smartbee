# Frontend Environment Variables (Vercel Deployment)

# Backend API Base URL
# Point this to your Render backend service URL
# Example: https://smartbee-backend.onrender.com/api
# If left empty in local dev, requests default to '/api' (proxied by local dev server)
VITE_API_BASE_URL=https://your-backend.onrender.com/api
VITE_API_URL=https://your-backend.onrender.com/api
